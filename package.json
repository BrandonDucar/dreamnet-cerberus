{
  "name": "@dreamnet/cerberus",
  "version": "0.1.0",
  "description": "A static, offline supply-chain airlock for repositories and agent bundles.",
  "type": "module",
  "bin": {
    "dreamnet-cerberus": "./scripts/cerberus.mjs"
  },
  "exports": {
    ".": "./packages/cerberus-core/src/index.mjs"
  },
  "files": [
    "scripts/",
    "packages/cerberus-core/src/",
    "policies/",
    "schemas/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test packages/cerberus-core/tests/*.test.mjs",
    "inspect": "node scripts/cerberus.mjs inspect",
    "gate": "node scripts/cerberus.mjs gate"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "keywords": [
    "supply-chain-security",
    "repository-scanner",
    "agent-security",
    "npm-security",
    "github-actions-security",
    "prompt-injection"
  ],
  "author": "DreamNet",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrandonDucar/dreamnet-cerberus.git"
  },
  "bugs": {
    "url": "https://github.com/BrandonDucar/dreamnet-cerberus/issues"
  },
  "homepage": "https://github.com/BrandonDucar/dreamnet-cerberus#readme"
}
